  {
    "id": "TC-11",
    "hw02Ref": "domain-testing.md#tc-11",
    "title": "Gap: fixed discount_value greater than total_amount must not yield a negative final_amount",
    "layer": "hybrid",
    "type": "edge",
    "arrange": {
      "loginAs": "test@eshop.com",
      "createCoupon": {
        "code": "GAPTEST1",
        "type": "fixed",
        "discount_value": 100000,
        "min_order_amount": 50000,
        "expired_at": "2099-12-31",
        "max_uses_per_user": 99
      }
    },
    "act": { "code": "GAPTEST1", "totalAmount": 60000, "authMode": "valid" },
    "assert": {
      "api": { "finalAmountNotNegative": true }
    },
    "knownDefect": "BUG-09-004"
  },
  {
    "id": "TC-12",
    "hw02Ref": "domain-testing.md#tc-12",
    "title": "Gap: total_amount=0 with min_order_amount=0 is a valid degenerate case (>=)",
    "layer": "hybrid",
    "type": "edge",
    "arrange": {
      "loginAs": "test@eshop.com",
      "createCoupon": {
        "code": "ZERO01",
        "type": "percent",
        "discount_value": 10,
        "min_order_amount": 0,
        "expired_at": "2099-12-31",
        "max_uses_per_user": 5
      }
    },
    "act": { "code": "ZERO01", "totalAmount": 0, "authMode": "valid" },
    "assert": {
      "api": { "status": 200, "discount_amount": 0, "final_amount": 0 }
    },
    "knownDefect": "BUG-09-005"
  },
  {
    "id": "TC-13",
    "hw02Ref": "domain-testing.md#tc-13",
    "title": "Gap: client-manipulated total_amount must not let the persisted order diverge from the real cart subtotal",
    "note": "Real cart subtotal is 0 here: add-to-cart cannot be automated (ui-survey.md P1-2, cart state is unreachable via direct /checkout navigation), so this TC always starts from a genuinely empty cart rather than a seeded non-zero one. That still proves BUG-09-007 — checkout must persist total_amount=0 for an empty cart, not the client-manipulated value.",
    "layer": "hybrid",
    "type": "edge",
    "arrange": {
      "loginAs": "test@eshop.com",
      "resetUsageFor": ["SAVE10"],
      "cartRealSubtotal": 0
    },
    "act": { "code": "SAVE10", "totalAmount": 500000, "authMode": "valid", "confirmCheckout": true },
    "assert": {
      "api": { "status": 200, "hasDiscount": true },
      "db": { "orderTotalMatchesRealSubtotal": true }
    },
    "knownDefect": "BUG-09-007"
  },
