[
  {
    "id": "TC-01",
    "hw02Ref": "domain-testing.md#tc-01",
    "title": "Apply valid percent coupon (happy path)",
    "layer": "hybrid",
    "type": "positive",
    "arrange": { "loginAs": "test@eshop.com", "resetUsageFor": ["SAVE10"] },
    "act": { "code": "SAVE10", "totalAmount": 500000, "authMode": "valid" },
    "assert": {
      "api": { "status": 200, "discount_amount": 50000, "final_amount": 450000 }
    },
    "knownDefect": "BUG-09-001"
  },
  {
    "id": "TC-02",
    "hw02Ref": "domain-testing.md#tc-02",
    "title": "Apply valid fixed coupon (happy path)",
    "layer": "hybrid",
    "type": "positive",
    "arrange": { "loginAs": "test@eshop.com", "resetUsageFor": ["BIGBUY"] },
    "act": { "code": "BIGBUY", "totalAmount": 600000, "authMode": "valid" },
    "assert": {
      "api": { "status": 200, "discount_amount": 50000, "final_amount": 550000 }
    },
    "knownDefect": null
  },
  {
    "id": "TC-03",
    "hw02Ref": "domain-testing.md#tc-03",
