    "type": "negative",
    "arrange": {
      "loginAs": "test@eshop.com",
      "resetUsageFor": ["SAVE10"],
      "consumeUsesViaCheckout": { "code": "SAVE10", "totalAmount": 500000, "times": 1 }
    },
    "act": { "code": "SAVE10", "totalAmount": 500000, "authMode": "valid" },
    "assert": {
