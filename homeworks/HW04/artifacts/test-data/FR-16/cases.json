  {
    "id": "TC-12",
    "hw02Ref": "domain-testing.md#tc-12",
    "title": "Atomic rollback: 1 invalid row among 3 must roll back the entire batch",
    "layer": "hybrid",
    "type": "negative",
    "arrange": { "loginAs": "admin@eshop.com" },
    "act": {
      "csvRows": [
        { "name": "Valid Product 1", "price": 100000, "category_id": 1 },
        { "name": "Invalid Row", "price": 0, "category_id": 1 },
        { "name": "Valid Product 2", "price": 200000, "category_id": 1 }
      ]
    },
    "assert": {
      "ui": { "previewCount": 3, "resultTextIncludes": "0/3", "errorsCount": 1, "errorRows": [3], "errorRowsMention": "price" },
      "api": { "inserted": 0, "errorsCount": 1, "errorRows": [3], "errorRowsMention": "price" },
      "db": { "productCountDelta": 0, "productsNotCreated": ["Valid Product 1", "Valid Product 2"] }
    },
    "knownDefect": "BUG-16-002",
    "note": "P2 finding (2026-08-05, deferred per TEST_PLAN.md §11): the import endpoint has no transaction — each row is inserted independently via stmt.run(), so this batch is expected to actually commit all 3 rows (price=0 is never validated, so nothing blocks any row). Kept the spec-correct expected value here per the explicit decision to defer the atomicity fix to P4; the resulting FAIL is expected to expose both BUG-16-002 (no price validation) and the not-yet-filed non-atomic-rollback defect together."
  },
