  {
    "id": "TC-01",
    "hw02Ref": "domain-testing.md#tc-01",
    "title": "Import one product with all valid fields",
    "layer": "hybrid",
    "type": "positive",
    "arrange": { "loginAs": "admin@eshop.com" },
    "act": {
      "csvRows": [
        { "name": "Basic Men's T-Shirt", "price": 150000, "description": "100% cotton material", "imageUrl": "", "category_id": 1 }
      ]
    },
    "assert": {
      "ui": { "previewCount": 1, "resultTextIncludes": "1/1", "errorsCount": 0 },
      "api": { "status": 200, "inserted": 1, "errorsCount": 0 },
      "db": { "productExists": "Basic Men's T-Shirt", "productCountDelta": 1, "persistedRowsMatchInput": true }
    },
    "knownDefect": null
  },
