{
  "info": {
    "_postman_id": "fr15prodcrud-0000-0000-0000-000000000001",
    "name": "FR-15 Product Management (Admin CRUD)",
    "description": "Data-driven collection for POST /api/products, PUT /api/products/:id, DELETE /api/products/:id, driven by test-data.csv (48 tc_id rows, one continuous sequence across all three operations). Access control is FR-12 (admin-only mutation). Item 1 is a one-time fixture (runs only on iteration 0): logs in the seeded admin and customer accounts, seeds products A/B/C used by the isolation and delete-lifecycle rows, and snapshots the baseline product count. Item 2 is the data-driven request; per-row execution shape (independent request, multi-step SEQUENCE, cross-response ANALYSIS, wire-level payload mutation) is resolved entirely in its own pre-request script. See homeworks/HW06/artifacts/test-cases/fr-15-product-crud/audit/audited-master-test-cases.md for the audited case source.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Fixture Setup / Login Admin+Customer, Seed Products A/B/C",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration > 0) {",
              "  pm.execution.skipRequest();",
              "} else {",
              "  function send(config) {",
              "    return new Promise((resolve, reject) => {",
              "      pm.sendRequest(config, (error, response) => {",
              "        if (error) { reject(error); return; }",
              "        resolve(response);",
              "      });",
              "    });",
              "  }",
              "",
              "  (async () => {",
              "    var studentId = pm.environment.get('studentId');",
              "    var baseUrl = pm.environment.get('baseUrl');",
              "",
              "    var adminLogin = await send({",
              "      url: baseUrl + '/api/login',",
              "      method: 'POST',",
              "      header: { 'Content-Type': 'application/json', 'X-Student-Id': studentId },",
              "      body: { mode: 'raw', raw: JSON.stringify({ email: 'admin@eshop.com', password: 'admin123' }) },",
              "    });",
              "    var adminToken = adminLogin.json().token;",
              "    pm.environment.set('adminToken', adminToken);",
              "",
              "    var customerLogin = await send({",
              "      url: baseUrl + '/api/login',",
              "      method: 'POST',",
              "      header: { 'Content-Type': 'application/json', 'X-Student-Id': studentId },",
              "      body: { mode: 'raw', raw: JSON.stringify({ email: 'test@eshop.com', password: 'Test1234!' }) },",
              "    });",
              "    var customerToken = customerLogin.json().token;",
              "    pm.environment.set('customerToken', customerToken);",
              "",
              "    var categoriesRes = await send({",
              "      url: baseUrl + '/api/categories',",
              "      method: 'GET',",
              "      header: { 'X-Student-Id': studentId },",
              "    });",
              "    var categoriesBody = categoriesRes.json();",
              "    var categoryList = Array.isArray(categoriesBody) ? categoriesBody : (categoriesBody.data || categoriesBody.categories || []);",
              "    var fixtureCategoryId = categoryList[0].id;",
              "    pm.environment.set('fixtureCategoryId', fixtureCategoryId);",
              "",
              "    function seedProduct(name, price, description) {",
              "      return send({",
              "        url: baseUrl + '/api/products',",
              "        method: 'POST',",
              "        header: {",
              "          'Content-Type': 'application/json',",
              "          Authorization: `Bearer ${adminToken}`,",
              "          'X-Student-Id': studentId,",
              "        },",
              "        body: {",
              "          mode: 'raw',",
              "          raw: JSON.stringify({",
              "            name: name,",
              "            price: price,",
              "            description: description,",
              "            imageUrl: 'http://example.com/img.png',",
              "            category_id: fixtureCategoryId,",
              "          }),",
              "        },",
              "      });",
              "    }",
              "",
              "    var productA = await seedProduct('Fixture Product A', 500000, 'Fixture product A - pre-seeded for FR-15 isolation checks (TC-21, TC-34)');",
              "    pm.environment.set('A_ID', productA.json().id);",
              "",
              "    var productB = await seedProduct('Fixture Product B', 600000, 'Fixture product B - pre-seeded for FR-15 isolation checks (TC-21, TC-34)');",
              "    pm.environment.set('B_ID', productB.json().id);",
              "",
              "    var productC = await seedProduct('Fixture Product C', 700000, 'Fixture product C - pre-seeded for FR-15 delete-lifecycle (TC-24)');",
              "    pm.environment.set('C_ID', productC.json().id);",
              "",
              "    var listBefore = await send({",
              "      url: baseUrl + '/api/products',",
              "      method: 'GET',",
              "      header: { 'X-Student-Id': studentId },",
              "    });",
              "    var listBeforeBody = listBefore.json();",
              "    var countBaseline = Array.isArray(listBeforeBody) ? listBeforeBody.length : (listBeforeBody.data || listBeforeBody.products || []).length;",
              "    pm.environment.set('productCountBaseline', countBaseline);",
              "",
              "    pm.request.method = 'GET';",
              "    pm.request.url = baseUrl + '/api/categories';",
              "    pm.request.headers.upsert({ key: 'X-Student-Id', value: String(studentId) });",
              "  })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration === 0 && pm.response && typeof pm.response.code !== 'undefined') {",
              "  pm.test('[FIXTURE] admin/customer tokens and products A/B/C seeded', () => {",
              "    pm.expect(pm.environment.get('adminToken')).to.be.a('string').and.not.empty;",
              "    pm.expect(pm.environment.get('customerToken')).to.be.a('string').and.not.empty;",
              "    pm.expect(pm.environment.get('A_ID')).to.not.be.undefined;",
              "    pm.expect(pm.environment.get('B_ID')).to.not.be.undefined;",
              "    pm.expect(pm.environment.get('C_ID')).to.not.be.undefined;",
              "    pm.expect(pm.environment.get('productCountBaseline')).to.not.be.undefined;",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categories"
          ]
        },
        "description": "Placeholder request definition; the pre-request script skips this item entirely for iteration > 0, and on iteration 0 rewrites it into the real baseline GET /api/categories call after logging in admin/customer and seeding products A, B, C."
      },
      "response": []
    },
    {
      "name": "Product CRUD / Data-Driven Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise((resolve, reject) => {",
              "    pm.sendRequest(config, (error, response) => {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function base64url(input) {",
              "  return btoa(unescape(encodeURIComponent(input)))",
              "    .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "",
              "function decodeBase64url(input) {",
              "  var padded = input.replace(/-/g, '+').replace(/_/g, '/');",
              "  while (padded.length % 4) { padded += '='; }",
              "  return decodeURIComponent(escape(atob(padded)));",
              "}",
              "",
              "function forgeJwt(payloadOverrides) {",
              "  var header = base64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
              "  var payload = base64url(JSON.stringify(Object.assign({ sub: 'forged' }, payloadOverrides)));",
              "  return header + '.' + payload + '.invalidsignature';",
              "}",
              "",
              "function tamperRealToken(realJwt, payloadOverrides) {",
              "  var parts = realJwt.split('.');",
              "  var decoded = JSON.parse(decodeBase64url(parts[1]));",
              "  var tampered = base64url(JSON.stringify(Object.assign({}, decoded, payloadOverrides)));",
              "  return parts[0] + '.' + tampered + '.' + parts[2];",
              "}",
              "",
              "function buildAuthHeader(authToken) {",
              "  if (!authToken) { return null; }",
              "  if (authToken === 'admin_valid') { return 'Bearer ' + pm.environment.get('adminToken'); }",
              "  if (authToken === 'customer_valid') { return 'Bearer ' + pm.environment.get('customerToken'); }",
              "  if (authToken === 'MISSING') { return null; }",
              "  if (authToken === 'MALFORMED') { return 'Bearer not-a-real-jwt-string'; }",
              "  if (authToken === 'EXPIRED') {",
              "    return 'Bearer ' + forgeJwt({ role: 'admin', exp: Math.floor(Date.now() / 1000) - 3600 });",
              "  }",
              "  if (authToken === 'TAMPERED_SIG_ADMIN_CLAIM') {",
              "    return 'Bearer ' + tamperRealToken(pm.environment.get('customerToken'), { role: 'admin' });",
              "  }",
              "  return null;",
              "}",
              "",
              "function randomLenString(len) {",
              "  var s = '';",
              "  while (s.length < len) { s += 'a'; }",
              "  return s.slice(0, len);",
              "}",
              "",
              "function buildProductBody(data) {",
              "  var body = {};",
              "",
              "  if (data.name_raw === 'OMIT_KEY') {",
              "    // omit name entirely",
              "  } else if (data.name_raw === 'EMPTY_STRING') {",
              "    body.name = '';",
              "  } else if (data.name_raw && data.name_raw.indexOf('LEN_') === 0) {",
              "    body.name = randomLenString(Number(data.name_raw.slice(4)));",
              "  } else {",
              "    body.name = data.name;",
              "  }",
              "",
              "  if (data.price_raw === 'OMIT_KEY') {",
              "    // omit price entirely",
              "  } else if (data.price_raw === 'RAW_TYPE_STRING') {",
              "    body.price = String(data.price);",
              "  } else {",
              "    body.price = Number(data.price);",
              "  }",
              "",
              "  if (data.description_raw === 'OMIT_KEY') {",
              "    // omit description entirely",
              "  } else {",
              "    body.description = data.description;",
              "  }",
              "",
              "  if (data.imageUrl_raw === 'OMIT_KEY') {",
              "    // omit imageUrl entirely",
              "  } else {",
              "    body.imageUrl = data.imageUrl;",
              "  }",
              "",
              "  return body;",
              "}",
              "",
              "function extractIdFromPath(path) {",
              "  var m = path && path.match(/\\{\\{(\\w+)\\}\\}/);",
              "  return m ? pm.environment.get(m[1]) : null;",
              "}",
              "",
              "async function resolveCategoryId(studentId) {",
              "  var res = await send({",
              "    url: pm.environment.get('baseUrl') + '/api/categories',",
              "    method: 'GET',",
              "    header: { 'X-Student-Id': studentId },",
              "  });",
              "  var body = res.json();",
              "  var list = Array.isArray(body) ? body : (body.data || body.categories || []);",
              "  return list[0].id;",
              "}",
              "",
              "async function runSequenceTC20(data, studentId) {",
              "  var baseUrl = pm.environment.get('baseUrl');",
              "  var categoryId = data.category_id;",
              "  if (categoryId === 'VALID_CATEGORY') {",
              "    categoryId = await resolveCategoryId(studentId);",
              "  }",
              "  var body = {",
              "    name: data.name,",
              "    price: Number(data.price),",
              "    description: data.description,",
              "    imageUrl: data.imageUrl,",
              "    category_id: Number(categoryId),",
              "  };",
              "",
              "  var createRes = await send({",
              "    url: baseUrl + '/api/products',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.environment.get('adminToken'), 'X-Student-Id': studentId },",
              "    body: { mode: 'raw', raw: JSON.stringify(body) },",
              "  });",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] create P2 request completes without a server error', () => {",
              "    pm.expect(createRes.code).to.be.below(500);",
              "  });",
              "  var created = createRes.json();",
              "  var p2Id = created && created.id;",
              "  pm.environment.set('P2_ID', p2Id);",
              "",
              "  var getRes = await send({",
              "    url: baseUrl + '/api/products/' + p2Id,",
              "    method: 'GET',",
              "    header: { 'X-Student-Id': studentId },",
              "  });",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] P2 is retrievable after creation', () => {",
              "    pm.expect(getRes.code).to.be.below(300);",
              "  });",
              "  var fetched = getRes.json();",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] P2 fields match submitted values on read-back', () => {",
              "    pm.expect(fetched.name).to.eql(body.name);",
              "    pm.expect(Number(fetched.price)).to.eql(body.price);",
              "    pm.expect(fetched.description).to.eql(body.description);",
              "    pm.expect(fetched.imageUrl).to.eql(body.imageUrl);",
              "    pm.expect(Number(fetched.category_id)).to.eql(body.category_id);",
              "  });",
              "}",
              "",
              "async function runSequenceTC21(data, studentId) {",
              "  var baseUrl = pm.environment.get('baseUrl');",
              "  var aId = pm.environment.get('A_ID');",
              "  var bId = pm.environment.get('B_ID');",
              "",
              "  var bBeforeRes = await send({ url: baseUrl + '/api/products/' + bId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "  var bBeforeText = bBeforeRes.text();",
              "",
              "  var categoryId = data.category_id;",
              "  if (categoryId === 'VALID_CATEGORY') {",
              "    categoryId = await resolveCategoryId(studentId);",
              "  }",
              "  var updateBody = {",
              "    name: data.name,",
              "    price: Number(data.price),",
              "    description: data.description,",
              "    imageUrl: data.imageUrl,",
              "    category_id: Number(categoryId),",
              "  };",
              "",
              "  var putRes = await send({",
              "    url: baseUrl + '/api/products/' + aId,",
              "    method: 'PUT',",
              "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.environment.get('adminToken'), 'X-Student-Id': studentId },",
              "    body: { mode: 'raw', raw: JSON.stringify(updateBody) },",
              "  });",
              "  pm.environment.set('captured_TC-21', JSON.stringify({ status: putRes.code, headers: putRes.headers.toObject(), body: putRes.text() }));",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] PUT on A completes without a server error', () => {",
              "    pm.expect(putRes.code).to.be.below(500);",
              "  });",
              "",
              "  var aAfterRes = await send({ url: baseUrl + '/api/products/' + aId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "  var aAfter = aAfterRes.json();",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] A reflects the update', () => {",
              "    pm.expect(aAfter.name).to.eql(updateBody.name);",
              "    pm.expect(Number(aAfter.price)).to.eql(updateBody.price);",
              "    pm.expect(Number(aAfter.category_id)).to.eql(updateBody.category_id);",
              "  });",
              "",
              "  var bAfterRes = await send({ url: baseUrl + '/api/products/' + bId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] B is unchanged by A\\'s update', () => {",
              "    pm.expect(bAfterRes.text()).to.eql(bBeforeText);",
              "  });",
              "}",
              "",
              "async function runSequenceTC24(data, studentId) {",
              "  var baseUrl = pm.environment.get('baseUrl');",
              "  var cId = pm.environment.get('C_ID');",
              "",
              "  var del1 = await send({ url: baseUrl + '/api/products/' + cId, method: 'DELETE', header: { Authorization: 'Bearer ' + pm.environment.get('adminToken'), 'X-Student-Id': studentId } });",
              "  pm.environment.set('captured_TC-24', JSON.stringify({ status: del1.code, headers: del1.headers.toObject(), body: del1.text() }));",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] first DELETE of C completes without a server error', () => {",
              "    pm.expect(del1.code).to.be.below(500);",
              "  });",
              "",
              "  var getRes = await send({ url: baseUrl + '/api/products/' + cId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] C is not retrievable after the first delete', () => {",
              "    pm.expect(getRes.code).to.be.at.least(400);",
              "  });",
              "",
              "  var del2 = await send({ url: baseUrl + '/api/products/' + cId, method: 'DELETE', header: { Authorization: 'Bearer ' + pm.environment.get('adminToken'), 'X-Student-Id': studentId } });",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] second DELETE of C matches TC-23\\'s not-found status for a nonexistent id', () => {",
              "    var tc23Raw = pm.environment.get('captured_TC-23');",
              "    if (tc23Raw) {",
              "      var tc23 = JSON.parse(tc23Raw);",
              "      pm.expect(del2.code).to.eql(tc23.status);",
              "    } else {",
              "      pm.expect(del2.code).to.be.at.least(400);",
              "    }",
              "  });",
              "}",
              "",
              "async function runSequenceTC46(data, studentId) {",
              "  var baseUrl = pm.environment.get('baseUrl');",
              "  var adminToken = pm.environment.get('adminToken');",
              "",
              "  var createCatRes = await send({",
              "    url: baseUrl + '/api/categories',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + adminToken, 'X-Student-Id': studentId },",
              "    body: { mode: 'raw', raw: data.body_raw_override },",
              "  });",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] create category CX completes without a server error', () => {",
              "    pm.expect(createCatRes.code).to.be.below(500);",
              "  });",
              "  var cx = createCatRes.json();",
              "  var cxId = cx && cx.id;",
              "  pm.environment.set('CX_ID', cxId);",
              "",
              "  var productBody = {",
              "    name: data.name,",
              "    price: Number(data.price),",
              "    description: data.description,",
              "    imageUrl: data.imageUrl,",
              "    category_id: cxId,",
              "  };",
              "  var createProdRes = await send({",
              "    url: baseUrl + '/api/products',",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + adminToken, 'X-Student-Id': studentId },",
              "    body: { mode: 'raw', raw: JSON.stringify(productBody) },",
              "  });",
              "  var prod = createProdRes.json();",
              "  var productCxId = prod && prod.id;",
              "  pm.environment.set('PRODUCT_CX_ID', productCxId);",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] product referencing CX is created', () => {",
              "    pm.expect(createProdRes.code).to.be.below(500);",
              "    pm.expect(productCxId).to.not.be.undefined;",
              "  });",
              "",
              "  var deleteCatRes = await send({",
              "    url: baseUrl + '/api/categories/' + cxId,",
              "    method: 'DELETE',",
              "    header: { Authorization: 'Bearer ' + adminToken, 'X-Student-Id': studentId },",
              "  });",
              "  pm.environment.set('tc46_deleteCategoryStatus', deleteCatRes.code);",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] delete category CX response recorded (cascade behavior UNSPECIFIED)', () => {",
              "    pm.expect(deleteCatRes.code).to.not.be.undefined;",
              "  });",
              "",
              "  var followUpRes = await send({",
              "    url: baseUrl + '/api/products/' + productCxId,",
              "    method: 'GET',",
              "    header: { 'X-Student-Id': studentId },",
              "  });",
              "  var followUpCategoryId = null;",
              "  try { followUpCategoryId = followUpRes.json().category_id; } catch (e) { followUpCategoryId = null; }",
              "  pm.environment.set('tc46_followUpStatus', followUpRes.code);",
              "  pm.environment.set('tc46_followUpCategoryId', followUpCategoryId);",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] follow-up GET of the CX-referencing product recorded (cascade behavior UNSPECIFIED)', () => {",
              "    pm.expect(followUpRes.code).to.not.be.undefined;",
              "  });",
              "}",
              "",
              "async function runSequence(data, studentId) {",
              "  if (data.tc_id === 'TC-20') { await runSequenceTC20(data, studentId); return; }",
              "  if (data.tc_id === 'TC-21') { await runSequenceTC21(data, studentId); return; }",
              "  if (data.tc_id === 'TC-24') { await runSequenceTC24(data, studentId); return; }",
              "  if (data.tc_id === 'TC-46') { await runSequenceTC46(data, studentId); return; }",
              "}",
              "",
              "var data = pm.iterationData.toObject();",
              "var studentId = pm.environment.get('studentId');",
              "",
              "(async () => {",
              "  var isSequenceRow = data.technique === 'Lifecycle' && data.method === 'SEQUENCE';",
              "  var isAnalysisRow = data.technique === 'Schema' && data.method === 'ANALYSIS';",
              "",
              "  if (isAnalysisRow) {",
              "    // Shape 4: cross-response analysis, no new request. Harmless placeholder",
              "    // (a 404 on this FR's own base path) so the Test phase still records",
              "    // assertions per script-templates.md sandbox constraint 5; real",
              "    // assertions run in the Test script keyed off captured_<tc_ref>.",
              "    pm.request.method = 'GET';",
              "    pm.request.url = pm.environment.get('baseUrl') + '/api/products/000000000';",
              "    pm.request.headers.upsert({ key: 'X-Student-Id', value: String(studentId) });",
              "    return;",
              "  }",
              "",
              "  if (isSequenceRow) {",
              "    await runSequence(data, studentId);",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  // Shape 1 + 9: independent single request, wire-level payload mutation",
              "  var categoryIdRaw = data.category_id;",
              "  var resolvedCategoryId = categoryIdRaw;",
              "  if (categoryIdRaw === 'VALID_CATEGORY') {",
              "    resolvedCategoryId = await resolveCategoryId(studentId);",
              "  }",
              "",
              "  pm.request.method = data.method;",
              "  pm.request.url = pm.environment.get('baseUrl') + data.path;",
              "",
              "  var authHeader = buildAuthHeader(data.auth_token);",
              "  if (authHeader) {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: authHeader });",
              "  } else {",
              "    pm.request.headers.remove('Authorization');",
              "  }",
              "",
              "  if (data.content_type) {",
              "    pm.request.headers.upsert({ key: 'Content-Type', value: data.content_type });",
              "  }",
              "",
              "  if (data.method === 'DELETE') {",
              "    pm.request.body = { mode: 'raw', raw: '' };",
              "  } else {",
              "    var body = buildProductBody(data);",
              "",
              "    if (data.category_id_raw === 'OMIT_KEY') {",
              "      // omit category_id entirely",
              "    } else if (data.category_id_raw === 'RAW_TYPE_STRING') {",
              "      body.category_id = String(resolvedCategoryId);",
              "    } else {",
              "      body.category_id = Number(resolvedCategoryId);",
              "    }",
              "",
              "    if (data.extra_field === 'INJECT_ROLE_ADMIN') { body.role = 'admin'; }",
              "    if (data.extra_field === 'INJECT_IS_ADMIN_TRUE') { body.isAdmin = true; }",
              "",
              "    pm.request.body = { mode: 'raw', raw: JSON.stringify(body) };",
              "  }",
              "",
              "  // \"Before\" snapshots for the Test script's count-unchanged / target-unchanged checks.",
              "  var note = (data.expected_side_effect_note || '').toLowerCase();",
              "  var baseUrl = pm.environment.get('baseUrl');",
              "",
              "  if (note.indexOf('no product created') > -1) {",
              "    var listBeforeRes = await send({ url: baseUrl + '/api/products', method: 'GET', header: { 'X-Student-Id': studentId } });",
              "    var listBeforeBody = listBeforeRes.json();",
              "    var countBefore = Array.isArray(listBeforeBody) ? listBeforeBody.length : (listBeforeBody.data || listBeforeBody.products || []).length;",
              "    pm.environment.set('countBefore_' + data.tc_id, countBefore);",
              "  }",
              "",
              "  // TC-34 checks B (not the request's own path target A) stays unchanged;",
              "  // TC-48a/TC-48b check P1 (not the request's own literal path id 0/-1).",
              "  var snapshotTargetOverride = null;",
              "  if (data.tc_id === 'TC-48a' || data.tc_id === 'TC-48b') { snapshotTargetOverride = pm.environment.get('P1_ID'); }",
              "  if (data.tc_id === 'TC-34') { snapshotTargetOverride = pm.environment.get('B_ID'); }",
              "",
              "  if (note.indexOf('unchanged') > -1 || note.indexOf('unaffected') > -1 || note.indexOf('still exists') > -1 || note.indexOf('still returns') > -1) {",
              "    var targetId = snapshotTargetOverride || extractIdFromPath(data.path);",
              "    if (targetId) {",
              "      var snapRes = await send({ url: baseUrl + '/api/products/' + targetId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "      pm.environment.set('snapshotBefore_' + data.tc_id, snapRes.text());",
              "      pm.environment.set('snapshotTargetId_' + data.tc_id, String(targetId));",
              "    }",
              "  }",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise((resolve, reject) => {",
              "    pm.sendRequest(config, (error, response) => {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function captured(tcId) {",
              "  var raw = pm.environment.get('captured_' + tcId);",
              "  return raw ? JSON.parse(raw) : null;",
              "}",
              "",
              "function extractIdFromPath(path) {",
              "  var m = path && path.match(/\\{\\{(\\w+)\\}\\}/);",
              "  return m ? pm.environment.get(m[1]) : null;",
              "}",
              "",
              "var data = pm.iterationData.toObject();",
              "var studentId = pm.environment.get('studentId');",
              "var isSequenceRow = data.technique === 'Lifecycle' && data.method === 'SEQUENCE';",
              "var isAnalysisRow = data.technique === 'Schema' && data.method === 'ANALYSIS';",
              "",
              "pm.test('[' + data.tc_id + '][' + data.trace + '] status is recorded, not asserted against an undocumented value', () => {",
              "  pm.environment.set('observed_status_' + data.tc_id, pm.response.code);",
              "});",
              "",
              "if (isSequenceRow) {",
              "  // All real assertions for this row already ran inside the pre-request",
              "  // script via send() (script-templates.md sandbox constraint 5) — nothing",
              "  // further to do here.",
              "} else if (isAnalysisRow) {",
              "  var refs = (data.tc_ref || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);",
              "  var rows = refs.map(function (id) { return captured(id); });",
              "",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] every referenced response was captured', () => {",
              "    rows.forEach(function (c, i) {",
              "      pm.expect(c, 'missing captured response for ' + refs[i]).to.not.eql(null);",
              "    });",
              "  });",
              "",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] referenced response(s) parse as JSON where a body is present, and carry no leaked internal error detail', () => {",
              "    rows.forEach(function (c) {",
              "      if (!c) { return; }",
              "      if (c.body && c.body.length > 0) {",
              "        var parsed;",
              "        try { parsed = JSON.parse(c.body); } catch (e) { parsed = undefined; }",
              "        pm.expect(parsed, 'body did not parse as JSON').to.not.be.undefined;",
              "      }",
              "      if (c.status >= 400) {",
              "        pm.expect(c.body).to.not.match(/<html/i);",
              "        pm.expect(c.body).to.not.match(/at\\s+\\S+\\s+\\(.*:\\d+:\\d+\\)/);",
              "      }",
              "    });",
              "  });",
              "",
              "  if (refs.length > 1) {",
              "    pm.test('[' + data.tc_id + '][' + data.trace + '] top-level key sets recorded for cross-response comparison', () => {",
              "      var keySets = rows.map(function (c) {",
              "        if (!c || !c.body) { return ''; }",
              "        try { return Object.keys(JSON.parse(c.body)).sort().join(','); } catch (e) { return '<unparsed>'; }",
              "      });",
              "      pm.environment.set('keySets_' + data.tc_id, JSON.stringify(keySets));",
              "      pm.expect(keySets.length).to.eql(refs.length);",
              "    });",
              "  }",
              "} else {",
              "  var note = (data.expected_side_effect_note || '').toLowerCase();",
              "",
              "  pm.test('[' + data.tc_id + '][' + data.trace + '] non-2xx-shaped response never leaks a stack trace / HTML error page', () => {",
              "    if (pm.response.code >= 400) {",
              "      var raw = pm.response.text();",
              "      pm.expect(raw).to.not.match(/<html/i);",
              "      pm.expect(raw).to.not.match(/at\\s+\\S+\\s+\\(.*:\\d+:\\d+\\)/);",
              "    }",
              "  });",
              "",
              "  if (data.trace && (data.trace.indexOf('SEC-C-09') > -1 || data.trace.indexOf('SEC-C-10') > -1 || data.trace.indexOf('SEC-05') > -1)) {",
              "    pm.test('[' + data.tc_id + '][' + data.trace + '] SQL injection payload never surfaces a raw DB error', () => {",
              "      var raw = pm.response.text();",
              "      pm.expect(raw).to.not.match(/SQLITE_ERROR|syntax error|SQL error/i);",
              "    });",
              "  }",
              "",
              "  if (data.tc_id === 'TC-01' && pm.response.code < 400) {",
              "    (function () {",
              "      try {",
              "        var createdBody = pm.response.json();",
              "        if (createdBody && createdBody.id !== undefined) {",
              "          pm.environment.set('P1_ID', createdBody.id);",
              "        }",
              "      } catch (e) { /* body not JSON: nothing to capture for P1_ID */ }",
              "    })();",
              "  }",
              "",
              "  (async () => {",
              "    var baseUrl = pm.environment.get('baseUrl');",
              "    var countBeforeVal = pm.environment.get('countBefore_' + data.tc_id);",
              "    if (countBeforeVal !== undefined && countBeforeVal !== null && countBeforeVal !== '') {",
              "      var listAfterRes = await send({ url: baseUrl + '/api/products', method: 'GET', header: { 'X-Student-Id': studentId } });",
              "      var listAfterBody = listAfterRes.json();",
              "      var countAfter = Array.isArray(listAfterBody) ? listAfterBody.length : (listAfterBody.data || listAfterBody.products || []).length;",
              "      pm.test('[' + data.tc_id + '][' + data.trace + '] no product created (catalog count unchanged)', () => {",
              "        pm.expect(countAfter).to.eql(Number(countBeforeVal));",
              "      });",
              "    }",
              "",
              "    var snapshotBeforeVal = pm.environment.get('snapshotBefore_' + data.tc_id);",
              "    if (snapshotBeforeVal) {",
              "      var targetId = pm.environment.get('snapshotTargetId_' + data.tc_id);",
              "      if (targetId) {",
              "        var snapAfterRes = await send({ url: baseUrl + '/api/products/' + targetId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "        pm.test('[' + data.tc_id + '][' + data.trace + '] target product unchanged after this request', () => {",
              "          pm.expect(snapAfterRes.text()).to.eql(snapshotBeforeVal);",
              "        });",
              "      }",
              "    }",
              "",
              "    if (data.extra_field === 'INJECT_ROLE_ADMIN' || data.extra_field === 'INJECT_IS_ADMIN_TRUE') {",
              "      var checkId;",
              "      if (data.method === 'POST') {",
              "        try { checkId = pm.response.json().id; } catch (e) { checkId = null; }",
              "      } else {",
              "        checkId = extractIdFromPath(data.path);",
              "      }",
              "      if (checkId) {",
              "        var checkRes = await send({ url: baseUrl + '/api/products/' + checkId, method: 'GET', header: { 'X-Student-Id': studentId } });",
              "        var checkBody;",
              "        try { checkBody = checkRes.json(); } catch (e) { checkBody = {}; }",
              "        pm.test('[' + data.tc_id + '][' + data.trace + '] injected privilege field is not persisted on the product record', () => {",
              "          if (data.extra_field === 'INJECT_ROLE_ADMIN') { pm.expect(checkBody.role).to.not.eql('admin'); }",
              "          if (data.extra_field === 'INJECT_IS_ADMIN_TRUE') { pm.expect(checkBody.isAdmin).to.not.eql(true); }",
              "        });",
              "      }",
              "    }",
              "  })();",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{name}}\",\n  \"price\": \"{{price}}\",\n  \"description\": \"{{description}}\",\n  \"imageUrl\": \"{{imageUrl}}\",\n  \"category_id\": \"{{category_id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "description": "Placeholder request definition; the request-level pre-request script rewrites method/url/headers/body per CSV row (see execution-shape classification in RUN.md)."
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var studentId = pm.environment.get('studentId');",
          "if (!studentId || !String(studentId).trim()) {",
          "  throw new Error('studentId is required; request not sent');",
          "}",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: String(studentId) });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var data = pm.iterationData ? pm.iterationData.toObject() : {};",
          "var isSequenceRow = data.technique === 'Lifecycle' && data.method === 'SEQUENCE';",
          "var isAnalysisRow = data.technique === 'Schema' && data.method === 'ANALYSIS';",
          "if (data.tc_id && !isSequenceRow && !isAnalysisRow && pm.response && typeof pm.response.code !== 'undefined') {",
          "  pm.environment.set(`captured_${data.tc_id}`, JSON.stringify({",
          "    status: pm.response.code,",
          "    headers: pm.response.headers ? pm.response.headers.toObject() : {},",
          "    body: pm.response.text ? pm.response.text() : '',",
          "  }));",
          "}"
        ]
      }
    }
  ],
  "variable": []
}
