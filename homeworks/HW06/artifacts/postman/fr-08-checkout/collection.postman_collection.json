{
  "info": {
    "_postman_id": "3f9d5b2e-2f6b-4b7e-9b7d-fr08checkout01",
    "name": "FR-08 Checkout",
    "description": "Data-driven collection for POST /api/checkout, driven by test-data.csv. Item 1 is a one-time fixture (runs only on iteration 0): provisions fresh User B / User C accounts, logs in User A, and snapshots User A's baseline order count. Item 2 is the data-driven checkout request; per-row execution shape (cart seeding, auth-header construction, wire-mutation, cross-actor isolation, cross-response analysis) is resolved entirely in its own pre-request script. See homeworks/HW06/artifacts/test-cases/fr-08-checkout/audit/audited-master-test-cases.md for the audited case source.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var studentId = pm.environment.get('studentId');",
          "if (!studentId || !String(studentId).trim()) {",
          "  throw new Error('studentId is required; request not sent');",
          "}",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: String(studentId) });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var data = pm.iterationData ? pm.iterationData.toObject() : {};",
          "if (data.tc_id) {",
          "  pm.environment.set(`captured_${data.tc_id}`, JSON.stringify({",
          "    status: pm.response.code,",
          "    headers: pm.response.headers.toObject(),",
          "    body: pm.response.text(),",
          "  }));",
          "}"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "Fixture Setup / Provision User A, B, C",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise(function (resolve, reject) {",
              "    pm.sendRequest(config, function (error, response) {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function safeJson(response) {",
              "  try { return response.json(); } catch (e) { return null; }",
              "}",
              "",
              "function registerConfig(email, password) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/register',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      'X-Student-Id': pm.environment.get('studentId'),",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ name: 'FR-08 Fixture User', email: email, password: password }) },",
              "  };",
              "}",
              "",
              "function loginConfig(email, password) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/login',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      'X-Student-Id': pm.environment.get('studentId'),",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ email: email, password: password }) },",
              "  };",
              "}",
              "",
              "if (pm.info.iteration > 0) {",
              "  pm.execution.skipRequest();",
              "} else {",
              "  (async () => {",
              "    var ts = Date.now();",
              "    var emailB = `fr08-userb-${ts}@eshop.com`;",
              "    var emailC = `fr08-userc-${ts}@eshop.com`;",
              "",
              "    var regB = await send(registerConfig(emailB, 'Test1234!'));",
              "    var regC = await send(registerConfig(emailC, 'Test1234!'));",
              "    pm.environment.set('userBId', (safeJson(regB) && safeJson(regB).id) || '');",
              "    pm.environment.set('userCId', (safeJson(regC) && safeJson(regC).id) || '');",
              "",
              "    var loginB = await send(loginConfig(emailB, 'Test1234!'));",
              "    var loginC = await send(loginConfig(emailC, 'Test1234!'));",
              "    pm.environment.set('tokenB', (safeJson(loginB) && safeJson(loginB).token) || '');",
              "    pm.environment.set('tokenC', (safeJson(loginC) && safeJson(loginC).token) || '');",
              "    pm.environment.set('emailB', emailB);",
              "    pm.environment.set('emailC', emailC);",
              "",
              "    var loginA = await send(loginConfig('test@eshop.com', 'Test1234!'));",
              "    var tokenAValue = (safeJson(loginA) && safeJson(loginA).token) || '';",
              "    pm.environment.set('tokenA', tokenAValue);",
              "",
              "    // Real visible request for this fixture item: baseline read of User A's",
              "    // order count before any checkout fires in this run -- needed by TC-38's",
              "    // oracle later (order count must be compared against a pre-run baseline,",
              "    // not invented).",
              "    pm.request.method = 'GET';",
              "    pm.request.url = pm.environment.get('baseUrl') + '/api/orders/my-orders';",
              "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${tokenAValue}` });",
              "    pm.request.headers.remove('Content-Type');",
              "    pm.request.body = { mode: 'raw', raw: '' };",
              "  })();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.info.iteration === 0) {",
              "  var body = null;",
              "  try { body = pm.response.json(); } catch (e) { body = null; }",
              "  var list = Array.isArray(body) ? body : ((body && (body.orders || body.items)) || []);",
              "  var count = Array.isArray(list) ? list.length : 0;",
              "  pm.environment.set('orderCountBaseline_userA', count);",
              "  pm.test('[FIXTURE][setup] baseline order count captured for User A, User B/C provisioned', () => {",
              "    pm.expect(typeof count).to.eql('number');",
              "    pm.expect(pm.environment.get('tokenA')).to.be.a('string').and.not.eql('');",
              "    pm.expect(pm.environment.get('tokenB')).to.be.a('string').and.not.eql('');",
              "    pm.expect(pm.environment.get('tokenC')).to.be.a('string').and.not.eql('');",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/orders/my-orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "my-orders"
          ]
        },
        "description": "Placeholder request definition; the pre-request script skips this item entirely for iteration > 0, and on iteration 0 rewrites it into the real baseline GET /api/orders/my-orders call for User A after provisioning User B/C."
      },
      "response": []
    },
    {
      "name": "Checkout / Data-Driven Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise(function (resolve, reject) {",
              "    pm.sendRequest(config, function (error, response) {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function safeJson(response) {",
              "  try { return response.json(); } catch (e) { return null; }",
              "}",
              "",
              "function base64url(input) {",
              "  return btoa(unescape(encodeURIComponent(input)))",
              "    .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '');",
              "}",
              "",
              "function forgeJwt(payloadOverrides) {",
              "  var header = base64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
              "  var payload = base64url(JSON.stringify(Object.assign({ sub: 'forged' }, payloadOverrides)));",
              "  return `${header}.${payload}.invalidsignature`;",
              "}",
              "",
              "function addToCartConfig(token, price) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/cart',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      Authorization: `Bearer ${token}`,",
              "      'X-Student-Id': pm.environment.get('studentId'),",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ id: Math.floor(Math.random() * 1000000), name: 'FR-08 fixture item', price: price, quantity: 1 }) },",
              "  };",
              "}",
              "",
              "function getCartConfig(token) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/cart',",
              "    method: 'GET',",
              "    header: { Authorization: `Bearer ${token}`, 'X-Student-Id': pm.environment.get('studentId') },",
              "  };",
              "}",
              "",
              "function getOrdersConfig(token) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/orders/my-orders',",
              "    method: 'GET',",
              "    header: { Authorization: `Bearer ${token}`, 'X-Student-Id': pm.environment.get('studentId') },",
              "  };",
              "}",
              "",
              "function checkoutConfig(token, shippingAddress, totalAmount) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/checkout',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      Authorization: `Bearer ${token}`,",
              "      'X-Student-Id': pm.environment.get('studentId'),",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ shipping_address: shippingAddress, total_amount: totalAmount }) },",
              "  };",
              "}",
              "",
              "function cartItems(cartResponse) {",
              "  var body = safeJson(cartResponse);",
              "  var items = (body && (body.items || body.cart)) || (Array.isArray(body) ? body : []);",
              "  return Array.isArray(items) ? items : [];",
              "}",
              "",
              "function cartTotal(cartResponse) {",
              "  return cartItems(cartResponse).reduce(function (sum, it) {",
              "    var price = Number(it.price || 0);",
              "    var qty = Number(it.quantity || 1);",
              "    return sum + price * qty;",
              "  }, 0);",
              "}",
              "",
              "function cartItemCount(cartResponse) {",
              "  return cartItems(cartResponse).length;",
              "}",
              "",
              "function firstItemPrice(cartResponse) {",
              "  var items = cartItems(cartResponse);",
              "  return items.length ? Number(items[0].price || 0) : 0;",
              "}",
              "",
              "function orderCount(ordersResponse) {",
              "  var body = safeJson(ordersResponse);",
              "  var list = (body && (body.orders || body.items)) || (Array.isArray(body) ? body : []);",
              "  return Array.isArray(list) ? list.length : 0;",
              "}",
              "",
              "async function ensureNonEmpty(token) {",
              "  var cart = await send(getCartConfig(token));",
              "  if (cartItemCount(cart) === 0) {",
              "    await send(addToCartConfig(token, 100000));",
              "    cart = await send(getCartConfig(token));",
              "  }",
              "  return cart;",
              "}",
              "",
              "async function ensureItemCount(token, n) {",
              "  var cart = await send(getCartConfig(token));",
              "  while (cartItemCount(cart) < n) {",
              "    await send(addToCartConfig(token, 100000));",
              "    cart = await send(getCartConfig(token));",
              "  }",
              "  return cart;",
              "}",
              "",
              "async function forceEmpty(token) {",
              "  // No dedicated clear-cart endpoint is documented for this SUT: the only",
              "  // observable way to empty a non-empty cart is a real checkout call. Its",
              "  // own outcome is itself one of this suite's UNSPECIFIED questions, so this",
              "  // is a best-effort precondition step, not an assertion -- if the SUT does",
              "  // not actually clear on this call, the row that depends on \"0 items\" will",
              "  // observe and record that instead of a forced/faked state.",
              "  var cart = await send(getCartConfig(token));",
              "  if (cartItemCount(cart) > 0) {",
              "    var total = cartTotal(cart);",
              "    await send(checkoutConfig(token, '123 Le Loi, TP.HCM', total));",
              "    cart = await send(getCartConfig(token));",
              "  }",
              "  return cart;",
              "}",
              "",
              "async function seedCart(tcId, tokenA, tokenB, tokenC) {",
              "  switch (tcId) {",
              "    case 'TC-01':",
              "      await ensureItemCount(tokenA, 2);",
              "      return;",
              "    case 'TC-07':",
              "    case 'TC-26':",
              "      await forceEmpty(tokenA);",
              "      await send(addToCartConfig(tokenA, 500000));",
              "      return;",
              "    case 'TC-14':",
              "      await forceEmpty(tokenA);",
              "      return;",
              "    case 'TC-15':",
              "      await forceEmpty(tokenA);",
              "      await send(addToCartConfig(tokenA, 150000));",
              "      return;",
              "    case 'TC-16':",
              "      await ensureNonEmpty(tokenA);",
              "      return;",
              "    case 'TC-17':",
              "    case 'TC-18':",
              "      // TC-17 relies on TC-16 (immediately preceding row) having actually",
              "      // cleared User A's cart; TC-18 relies on User C never having touched",
              "      // a cart since fixture registration. Neither gets a forced setup call.",
              "      return;",
              "    case 'TC-20':",
              "    case 'TC-25': {",
              "      await ensureNonEmpty(tokenA);",
              "      await ensureNonEmpty(tokenB);",
              "      var beforeCartB = await send(getCartConfig(tokenB));",
              "      var beforeOrdersB = await send(getOrdersConfig(tokenB));",
              "      pm.environment.set(`before_cart_${tcId}`, JSON.stringify(safeJson(beforeCartB)));",
              "      pm.environment.set(`before_orders_${tcId}`, JSON.stringify(safeJson(beforeOrdersB)));",
              "      return;",
              "    }",
              "    default:",
              "      await ensureNonEmpty(tokenA);",
              "      return;",
              "  }",
              "}",
              "",
              "function resolveShippingAddress(data) {",
              "  if (data.shipping_address_raw === 'OMIT_KEY') return { omit: true };",
              "  if (data.shipping_address_raw === 'RAW_TYPE_NULL') return { value: null };",
              "  if (data.shipping_address_raw === 'RAW_TYPE_NUMBER') return { value: Number(data.shipping_address) };",
              "  if (data.shipping_address === 'LONG_STRING_5000_CHARS') return { value: 'a'.repeat(5000) };",
              "  return { value: data.shipping_address };",
              "}",
              "",
              "function resolveTotalAmount(data, resolvedCartTotal, resolvedItemPrice) {",
              "  if (data.total_amount_raw === 'OMIT_KEY') return { omit: true };",
              "  if (data.total_amount_raw === 'RAW_TYPE_STRING') return { value: String(data.total_amount) };",
              "  if (data.total_amount === 'REAL_CART_TOTAL') return { value: resolvedCartTotal };",
              "  if (data.total_amount === 'ITEM_PRICE') return { value: resolvedItemPrice };",
              "  return { value: Number(data.total_amount) };",
              "}",
              "",
              "function buildAuthHeaderValue(authToken, tokenA, tokenB, tokenC) {",
              "  if (authToken === 'valid_userA') return `Bearer ${tokenA}`;",
              "  if (authToken === 'valid_userB') return `Bearer ${tokenB}`;",
              "  if (authToken === 'valid_userC') return `Bearer ${tokenC}`;",
              "  if (authToken === 'MISSING') return null;",
              "  if (authToken === 'MALFORMED') return 'Bearer not-a-real-token';",
              "  if (authToken === 'FORGED_BAD_SIG') return `Bearer ${forgeJwt({})}`;",
              "  if (authToken === 'EXPIRED') return `Bearer ${forgeJwt({ exp: Math.floor(Date.now() / 1000) - 3600 })}`;",
              "  if (authToken === 'NO_SCHEME') return tokenA;",
              "  if (authToken === 'WRONG_SCHEME_BASIC') return 'Basic dXNlcjpwYXNz';",
              "  return null;",
              "}",
              "",
              "// Rows referenced by TC-31/TC-32/TC-37's \"no order created / cart unaffected\"",
              "// analysis, plus every row whose own oracle states the same invariant",
              "// directly -- before/after order-count and cart-item-count snapshots are",
              "// captured around these so the analysis rows compare real numbers, not an",
              "// invented delta.",
              "var NEEDS_SNAPSHOT = [",
              "  'TC-02', 'TC-03', 'TC-04', 'TC-05', 'TC-06', 'TC-07', 'TC-08', 'TC-09', 'TC-10', 'TC-13',",
              "  'TC-11', 'TC-12', 'TC-14', 'TC-21', 'TC-22', 'TC-23', 'TC-24', 'TC-36a', 'TC-36b',",
              "];",
              "",
              "var data = pm.iterationData.toObject();",
              "",
              "(async () => {",
              "  var tokenA = pm.environment.get('tokenA');",
              "  var tokenB = pm.environment.get('tokenB');",
              "  var tokenC = pm.environment.get('tokenC');",
              "",
              "  // TC-38 / TC-39: endpoint_override fires a GET against a different route",
              "  // entirely, authenticated as whichever account the row names.",
              "  if (data.endpoint_override) {",
              "    var parts = data.endpoint_override.split(' ');",
              "    var method = parts[0];",
              "    var path = parts.slice(1).join(' ');",
              "    var overrideToken = data.auth_token === 'valid_userB' ? tokenB : tokenA;",
              "    pm.request.method = method;",
              "    pm.request.url = pm.environment.get('baseUrl') + path;",
              "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${overrideToken}` });",
              "    pm.request.headers.remove('Content-Type');",
              "    pm.request.body = { mode: 'raw', raw: '' };",
              "    return;",
              "  }",
              "",
              "  // TC-29/30/31/32/35/37/40: cross-response analysis rows, no new checkout",
              "  // request under test. Harmless placeholder (GET on this FR's POST-only",
              "  // route) so the Test phase still records assertions (sandbox constraint 5).",
              "  if (!data.auth_token && data.tc_ref) {",
              "    pm.request.method = 'GET';",
              "    pm.request.url = pm.environment.get('baseUrl') + '/api/checkout';",
              "    pm.request.body.mode = 'raw';",
              "    pm.request.body.raw = '';",
              "    pm.request.headers.remove('Content-Type');",
              "    return;",
              "  }",
              "",
              "  // Every remaining row is a real POST /api/checkout under test.",
              "  await seedCart(data.tc_id, tokenA, tokenB, tokenC);",
              "",
              "  if (NEEDS_SNAPSHOT.indexOf(data.tc_id) !== -1) {",
              "    var ob = await send(getOrdersConfig(tokenA));",
              "    var cb = await send(getCartConfig(tokenA));",
              "    pm.environment.set(`orderCountBefore_${data.tc_id}`, orderCount(ob));",
              "    pm.environment.set(`cartCountBefore_${data.tc_id}`, cartItemCount(cb));",
              "  }",
              "",
              "  var cartOwnerToken = data.tc_id === 'TC-18' ? tokenC : tokenA;",
              "  var cartResp = await send(getCartConfig(cartOwnerToken));",
              "  var resolvedTotal = cartTotal(cartResp);",
              "  var resolvedItemPrice = firstItemPrice(cartResp);",
              "",
              "  var addr = resolveShippingAddress(data);",
              "  var tot = resolveTotalAmount(data, resolvedTotal, resolvedItemPrice);",
              "",
              "  var bodyObj = {};",
              "  if (!addr.omit) bodyObj.shipping_address = addr.value;",
              "  if (!tot.omit) bodyObj.total_amount = tot.value;",
              "",
              "  if (data.extra_field === 'INJECT_USER_ID_B') {",
              "    bodyObj.user_id = pm.environment.get('userBId');",
              "    bodyObj.cart_id = pm.environment.get('userBId');",
              "  }",
              "",
              "  var authHeaderValue = buildAuthHeaderValue(data.auth_token, tokenA, tokenB, tokenC);",
              "",
              "  if (data.extra_field === 'DOUBLE_SUBMIT') {",
              "    var cfg = checkoutConfig(tokenA, addr.value, tot.value);",
              "    var pair = await Promise.all([send(cfg), send(cfg)]);",
              "    pm.environment.set('doubleSubmit_status1', pair[0].code);",
              "    pm.environment.set('doubleSubmit_status2', pair[1].code);",
              "    pm.test(`[${data.tc_id}][${data.trace}] double-submit: neither concurrent response is a raw unhandled crash (5xx)`, () => {",
              "      pm.expect(pair[0].code).to.be.below(500);",
              "      pm.expect(pair[1].code).to.be.below(500);",
              "    });",
              "    pm.execution.skipRequest(); // real traffic already sent via both send() calls above -- safe per constraint 5",
              "    return;",
              "  }",
              "",
              "  pm.request.method = 'POST';",
              "  pm.request.url = pm.environment.get('baseUrl') + '/api/checkout';",
              "",
              "  if (authHeaderValue === null) {",
              "    pm.request.headers.remove('Authorization');",
              "  } else {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: authHeaderValue });",
              "  }",
              "",
              "  if (data.body_raw_override) {",
              "    pm.request.body = { mode: 'raw', raw: data.body_raw_override };",
              "  } else {",
              "    pm.request.body = { mode: 'raw', raw: JSON.stringify(bodyObj) };",
              "  }",
              "",
              "  if (data.content_type === 'OMIT_HEADER') {",
              "    pm.request.headers.remove('Content-Type');",
              "  } else if (data.content_type) {",
              "    pm.request.headers.upsert({ key: 'Content-Type', value: data.content_type });",
              "  }",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise(function (resolve, reject) {",
              "    pm.sendRequest(config, function (error, response) {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function safeJson(response) {",
              "  try { return response.json(); } catch (e) { return null; }",
              "}",
              "",
              "function safeJsonParse(text) {",
              "  try { return JSON.parse(text); } catch (e) { return null; }",
              "}",
              "",
              "function cartItems(cartResponse) {",
              "  var body = safeJson(cartResponse);",
              "  var items = (body && (body.items || body.cart)) || (Array.isArray(body) ? body : []);",
              "  return Array.isArray(items) ? items : [];",
              "}",
              "",
              "function cartItemCount(cartResponse) {",
              "  return cartItems(cartResponse).length;",
              "}",
              "",
              "function orderCount(ordersResponse) {",
              "  var body = safeJson(ordersResponse);",
              "  var list = (body && (body.orders || body.items)) || (Array.isArray(body) ? body : []);",
              "  return Array.isArray(list) ? list.length : 0;",
              "}",
              "",
              "function getCartConfig(token) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/cart',",
              "    method: 'GET',",
              "    header: { Authorization: `Bearer ${token}`, 'X-Student-Id': pm.environment.get('studentId') },",
              "  };",
              "}",
              "",
              "function getOrdersConfig(token) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/orders/my-orders',",
              "    method: 'GET',",
              "    header: { Authorization: `Bearer ${token}`, 'X-Student-Id': pm.environment.get('studentId') },",
              "  };",
              "}",
              "",
              "function captured(tcId) {",
              "  var raw = pm.environment.get(`captured_${tcId}`);",
              "  return raw ? JSON.parse(raw) : null;",
              "}",
              "",
