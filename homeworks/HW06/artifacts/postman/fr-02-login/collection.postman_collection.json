{
  "info": {
    "_postman_id": "82657a9e-f9cd-4502-b151-ea822fa7cbe0",
    "name": "FR-02 Login & Account Lockout",
    "description": "Data-driven collection for POST /api/login (and the TC-38b protected-endpoint follow-up GET /api/users/me), driven by test-data.csv. One data-driven item; per-row execution shape resolved in the request-level pre-request script. See homeworks/HW06/artifacts/test-cases/fr-02-login/audit/audited-master-test-cases.md for the audited case source.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var studentId = pm.environment.get('studentId');",
          "if (!studentId || !String(studentId).trim()) {",
          "  throw new Error('studentId is required; request not sent');",
          "}",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: String(studentId) });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function safeJson(response) {",
          "  try { return response.json(); } catch (e) { return null; }",
          "}",
          "",
          "var data = pm.iterationData ? pm.iterationData.toObject() : {};",
          "",
          "if (data.tc_id) {",
          "  pm.environment.set(`captured_${data.tc_id}`, JSON.stringify({",
          "    status: pm.response.code,",
          "    headers: pm.response.headers.toObject(),",
          "    body: pm.response.text(),",
          "  }));",
          "}",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] status matches expected_status when documented`, () => {",
          "  if (data.expected_status) {",
          "    pm.expect(pm.response.code).to.eql(Number(data.expected_status));",
          "  } else {",
          "    pm.environment.set(`observed_status_${data.tc_id}`, pm.response.code);",
          "  }",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] token presence matches expected_token_present`, () => {",
          "  var body = safeJson(pm.response);",
          "  var hasToken = !!(body && typeof body.token !== 'undefined');",
          "  if (data.expected_token_present === 'true') {",
          "    pm.expect(hasToken).to.be.true;",
          "  } else if (data.expected_token_present === 'false') {",
          "    pm.expect(hasToken).to.be.false;",
          "  } else {",
          "    pm.environment.set(`observed_token_present_${data.tc_id}`, hasToken);",
          "  }",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] response never leaks a password field`, () => {",
          "  var raw = pm.response.text();",
          "  pm.expect(raw.toLowerCase()).to.not.include('\"password\"');",
          "  pm.expect(raw.toLowerCase()).to.not.include('\"passwordhash\"');",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] non-2xx responses never return a raw stack trace / HTML error page`, () => {",
          "  if (pm.response.code >= 400) {",
          "    var raw = pm.response.text();",
          "    pm.expect(raw).to.not.match(/<html/i);",
          "    pm.expect(raw).to.not.match(/at\\s+\\S+\\s+\\(.*:\\d+:\\d+\\)/);",
          "  }",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] 2xx responses declare Content-Type: application/json`, () => {",
          "  if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "Login / Data-Driven Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise(function (resolve, reject) {",
              "    pm.sendRequest(config, function (error, response) {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function sleep(ms) {",
              "  return new Promise(function (resolve) { setTimeout(resolve, ms); });",
              "}",
              "",
              "function waitOutTestLock() {",
              "  return new Promise(function (resolve) {",
              "    var until = Number(pm.environment.get('lockUntil_test'));",
              "    var wait = until ? until - Date.now() : 0;",
              "    if (wait > 0) {",
              "      setTimeout(resolve, wait + 500);",
              "    } else {",
              "      resolve();",
              "    }",
              "  });",
              "}",
              "",
              "function loginConfig(email, password) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/login',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      'X-Student-Id': pm.environment.get('studentId'),",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ email: email, password: password }) },",
              "  };",
              "}",
              "",
              "function buildLoginBody() {",
              "  var obj = {};",
              "  if (data.email_raw_json === 'OMIT_KEY') {",
              "    // key intentionally omitted (TC-06)",
              "  } else if (data.email_raw_json === 'RAW_TYPE_NULL') {",
              "    obj.email = null;",
              "  } else if (data.email_raw_json === 'RAW_TYPE_NUMBER') {",
              "    obj.email = Number(data.email);",
              "  } else {",
              "    obj.email = data.email;",
              "  }",
              "  if (data.password_raw_json === 'OMIT_KEY') {",
              "    // key intentionally omitted (TC-10)",
              "  } else if (data.password_raw_json === 'RAW_TYPE_ARRAY') {",
              "    obj.password = JSON.parse(data.password);",
              "  } else {",
              "    obj.password = data.password;",
              "  }",
              "  return obj;",
              "}",
              "",
              "function applyDefaultRequest() {",
              "  pm.request.method = data.method;",
              "  pm.request.url = pm.environment.get('baseUrl') + data.endpoint;",
              "  if (data.body_raw_override) {",
              "    pm.request.body = { mode: 'raw', raw: data.body_raw_override };",
              "  } else {",
              "    pm.request.body = { mode: 'raw', raw: JSON.stringify(buildLoginBody()) };",
              "  }",
              "  if (data.content_type === 'OMIT_HEADER') {",
              "    pm.request.headers.remove('Content-Type');",
              "  } else if (data.content_type) {",
              "    pm.request.headers.upsert({ key: 'Content-Type', value: data.content_type });",
              "  }",
              "}",
              "",
              "var data = pm.iterationData.toObject();",
              "",
              "(async () => {",
              "  if (!data.method && !data.endpoint) {",
              "    // Shape 4 (TC-28..TC-31): cross-response analysis, no new request under test.",
              "    // Harmless placeholder so the Test phase still records assertions (sandbox",
              "    // constraint 5) -- GET on this FR's POST-only route, no SUT state mutation.",
              "    pm.request.method = 'GET';",
              "    pm.request.url = pm.environment.get('baseUrl') + '/api/login';",
              "    pm.request.body.mode = 'raw';",
              "    pm.request.body.raw = '';",
              "    pm.request.headers.remove('Content-Type');",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-13' || data.tc_id === 'TC-14' || data.tc_id === 'TC-15') {",
              "    // Fresh 3-failure sequence arms a new lock, then wait to this row's own",
              "    // boundary offset before firing the real (visible) timed request.",
              "    var targetMs = data.tc_id === 'TC-13' ? 29000 : (data.tc_id === 'TC-14' ? 30000 : 31000);",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    var t0 = Date.now();",
              "    pm.environment.set('lockUntil_test', t0 + 30000);",
              "    var wait = targetMs - (Date.now() - t0);",
              "    if (wait > 0) await sleep(wait);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-01' || data.tc_id === 'TC-21' || data.tc_id === 'TC-23' || data.tc_id === 'TC-38a') {",
              "    // These rows' precondition requires test@eshop.com unlocked/counter=0",
              "    // (\"reset, or wait out TC-20's 30s lock, before running this row\" per the",
              "    // audited suite) -- wait out any lock a prior row in this run armed.",
              "    await waitOutTestLock();",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-16') {",
              "    // The row itself is the 3-consecutive-attempt sequence; no single visible",
              "    // request represents it, so all traffic goes through send() and the",
              "    // per-attempt assertions live here (sandbox constraint 5: real traffic",
              "    // already fired before skipRequest()).",
              "    var r1 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] attempt 1 rejected (same error class as EC-09)`, () => {",
              "      pm.expect(r1.code).to.not.eql(200);",
              "    });",
              "    var r2 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] attempt 2 rejected (same error class as EC-09)`, () => {",
              "      pm.expect(r2.code).to.not.eql(200);",
              "    });",
              "    var r3 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] attempt 3 triggers lock (counter reaches 3)`, () => {",
              "      pm.expect(r3.code).to.not.eql(200);",
              "    });",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-19') {",
              "    // Precondition needs a fresh (unlocked) account before the 1-failure setup.",
              "    await waitOutTestLock();",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    var step1 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] step1 success login returns 200+token`, () => {",
              "      pm.expect(step1.code).to.eql(200);",
              "      pm.expect(step1.json()).to.have.property('token');",
              "    });",
              "    var step2 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-19-step2', step2.code);",
              "    pm.test(`[${data.tc_id}][${data.trace}] step2 follow-up failure recorded (reset-vs-cumulative is UNSPECIFIED)`, () => {",
              "      pm.expect(step2.code).to.not.eql(200);",
              "    });",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-20') {",
              "    // Wait out TC-16's 30s lock window (plus margin), then fire 3 more",
              "    // consecutive failures and record which attempt re-triggers the lock --",
              "    // the post-unlock counter value is UNSPECIFIED, so no attempt number is",
              "    // asserted as *the* one that re-locks.",
              "    await waitOutTestLock();",
              "    var attempts = [];",
              "    for (var i = 0; i < 3; i++) {",
              "      var res = await send(loginConfig(data.email, data.password));",
              "      attempts.push(res.code);",
              "      pm.environment.set(`observed_status_TC-20-attempt${i + 1}`, res.code);",
              "      pm.test(`[${data.tc_id}][${data.trace}] attempt ${i + 1} rejected`, () => {",
              "        pm.expect(res.code).to.not.eql(200);",
              "      });",
              "    }",
              "    // The post-unlock counter (and thus which attempt re-arms the lock) is",
              "    // UNSPECIFIED; conservatively assume this 2nd cycle re-locked the account",
              "    // so downstream rows requiring \"unlocked\" wait it out correctly.",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-36') {",
              "    // Setup needs a fresh (unlocked) account, then two prior wrong-password",
              "    // attempts bring counter to 2, then this row's own correct-credential",
              "    // request fires as the real visible request.",
              "    await waitOutTestLock();",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-38b') {",
              "    // auth_bearer_from: reuse the token captured from TC-38a's own response",
              "    // (SS0's collection-level capture already stored it) instead of a fresh fetch.",
              "    var capturedRaw = pm.environment.get(`captured_${data.auth_bearer_from}`);",
              "    var capturedParsed = capturedRaw ? JSON.parse(capturedRaw) : null;",
              "    var token = '';",
              "    if (capturedParsed && capturedParsed.body) {",
              "      try { token = JSON.parse(capturedParsed.body).token || ''; } catch (e) { token = ''; }",
              "    }",
              "    pm.request.method = data.method;",
              "    pm.request.url = pm.environment.get('baseUrl') + data.endpoint;",
              "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
              "    pm.request.headers.remove('Content-Type');",
              "    pm.request.body = { mode: 'raw', raw: '' };",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-39') {",
              "    // Lock actor A (test@eshop.com) first, then this row's own request logs",
              "    // in as actor B (admin@eshop.com) to prove the lock is scoped per-account.",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-40') {",
              "    // Concurrency: 3 wrong-password attempts fired without waiting for each",
              "    // other, then a correct-credential verification call.",
              "    var fire = function () { return send(loginConfig(data.email, data.password)); };",
              "    var results = await Promise.all([fire(), fire(), fire()]);",
              "    results.forEach(function (res, i) {",
              "      pm.environment.set(`observed_status_TC-40-attempt${i + 1}`, res.code);",
              "      pm.test(`[${data.tc_id}][${data.trace}] concurrent attempt ${i + 1} recorded`, () => {",
              "        pm.expect(res.code).to.not.eql(200);",
              "      });",
              "    });",
              "    var verify = await send(loginConfig(data.email, 'Test1234!'));",
              "    pm.test(`[${data.tc_id}][${data.trace}] final state is LOCKED (no lost-update: correct creds still rejected)`, () => {",
              "      pm.expect(verify.code).to.not.eql(200);",
              "    });",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  applyDefaultRequest();",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function captured(tcId) {",
              "  var raw = pm.environment.get(`captured_${tcId}`);",
              "  return raw ? JSON.parse(raw) : null;",
              "}",
              "",
              "var data = pm.iterationData.toObject();",
              "",
              "if (data.tc_id === 'TC-28') {",
              "  var refs28 = (data.precondition_note.match(/TC-\\d+[a-z]?/g) || []);",
              "  var rows28 = refs28.map((id) => captured(id));",
              "  pm.test(`[${data.tc_id}][${data.trace}] all referenced error bodies share the same top-level key set`, () => {",
              "    rows28.forEach((c, i) => pm.expect(c, `missing captured response for ${refs28[i]}`).to.not.eql(null));",
              "    var keySets = rows28.map((c) => Object.keys(JSON.parse(c.body || '{}')).sort().join(','));",
              "    pm.expect(new Set(keySets).size).to.eql(1);",
              "  });",
              "}",
              "",
              "if (data.tc_id === 'TC-29') {",
              "  var refs29 = (data.precondition_note.match(/TC-\\d+[a-z]?/g) || []);",
              "  var rows29 = refs29.map((id) => captured(id));",
              "  pm.test(`[${data.tc_id}][${data.trace}] unknown-email vs wrong-password bodies do not let the client distinguish cause`, () => {",
              "    rows29.forEach((c, i) => pm.expect(c, `missing captured response for ${refs29[i]}`).to.not.eql(null));",
              "    var msgs = rows29.map((c) => JSON.parse(c.body || '{}').message || '');",
              "    pm.expect(new Set(msgs).size).to.eql(1);",
              "  });",
              "}",
              "",
              "if (data.tc_id === 'TC-30') {",
              "  var refs30 = (data.precondition_note.match(/TC-\\d+[a-z]?/g) || []);",
              "  var rows30 = refs30.map((id) => captured(id));",
              "  pm.test(`[${data.tc_id}][${data.trace}] locked-account error body omits password/passwordHash`, () => {",
              "    rows30.forEach((c, i) => pm.expect(c, `missing captured response for ${refs30[i]}`).to.not.eql(null));",
              "    rows30.forEach((c) => {",
              "      var raw = (c.body || '').toLowerCase();",
              "      pm.expect(raw).to.not.include('\"password\"');",
              "      pm.expect(raw).to.not.include('\"passwordhash\"');",
              "    });",
              "  });",
              "}",
              "",
              "if (data.tc_id === 'TC-31') {",
              "  var refs31 = (data.precondition_note.match(/TC-\\d+[a-z]?/g) || []);",
              "  var rows31 = refs31.map((id) => captured(id));",
              "  pm.test(`[${data.tc_id}][${data.trace}] all referenced conditions return a non-2xx status`, () => {",
              "    rows31.forEach((c, i) => pm.expect(c, `missing captured response for ${refs31[i]}`).to.not.eql(null));",
              "    rows31.forEach((c) => {",
              "      pm.expect(c.status >= 200 && c.status < 300).to.be.false;",
              "    });",
              "  });",
              "}",
              "",
              "if (data.tc_id === 'TC-38b') {",
              "  pm.test(`[${data.tc_id}][${data.trace}] token issued by TC-38a is accepted by the protected endpoint`, () => {",
              "    pm.expect(pm.response.code).to.not.be.oneOf([401, 403]);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "description": "Placeholder request definition; the request-level pre-request script rewrites method/url/headers/body per CSV row (see execution-shapes classification in RUN.md)."
      },
      "response": []
    }
  ]
}
