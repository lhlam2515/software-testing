{
  "info": {
    "name": "FR-02 Login & Account Lockout - Data-Driven (audited v2)",
    "description": "Data-driven Newman package for FR-02 POST /api/login. One item; the request-level pre-request script dispatches every CSV row by tc_id/columns. Built from audit/audited-master-test-cases-v2.md via data/test-data.csv + data/request-template.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "var studentId = pm.environment.get('studentId');",
          "if (!studentId || !String(studentId).trim()) {",
          "  throw new Error('studentId is required; request not sent');",
          "}",
          "pm.request.headers.upsert({ key: 'X-Student-Id', value: String(studentId) });"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function safeJson(response) {",
          "  try { return response.json(); } catch (e) { return null; }",
          "}",
          "",
          "var data = pm.iterationData ? pm.iterationData.toObject() : {};",
          "",
          "// SEC-05 (srs.md line 282) is the only source asserting \"no raw SQL error / stack",
          "// trace\" for a non-2xx body, and it names the SQLi probes as its cases. Every other",
          "// non-2xx row is silent on that facet (request-template.md section 3).",
          "var SQLI_ROWS = ['TC-25', 'TC-26', 'TC-27'];",
          "",
          "// Rows whose audited v2 oracle is characterization-only: \"record the status, the",
          "// Content-Type, whether the body parses as JSON, and whether it exposes a stack",
          "// trace or an HTML error page; assert none of these.\"",
          "var CHARACTERIZATION_ROWS = ['TC-32', 'TC-33', 'TC-34', 'TC-41'];",
          "",
          "if (data.tc_id) {",
          "  pm.environment.set(`captured_${data.tc_id}`, JSON.stringify({",
          "    status: pm.response.code,",
          "    headers: pm.response.headers.toObject(),",
          "    body: pm.response.text(),",
          "  }));",
          "}",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] status matches expected_status when documented`, () => {",
          "  if (data.expected_status) {",
          "    pm.expect(pm.response.code).to.eql(Number(data.expected_status));",
          "  } else {",
          "    pm.environment.set(`observed_status_${data.tc_id}`, pm.response.code);",
          "  }",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] token presence matches expected_token_present`, () => {",
          "  var body = safeJson(pm.response);",
          "  var hasToken = !!(body && typeof body.token !== 'undefined');",
          "  if (data.expected_token_present === 'true') {",
          "    pm.expect(hasToken).to.be.true;",
          "  } else if (data.expected_token_present === 'false') {",
          "    pm.expect(hasToken).to.be.false;",
          "  } else {",
          "    pm.environment.set(`observed_token_present_${data.tc_id}`, hasToken);",
          "  }",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] response never leaks a password field`, () => {",
          "  var raw = pm.response.text();",
          "  pm.expect(raw.toLowerCase()).to.not.include('\"password\"');",
          "  pm.expect(raw.toLowerCase()).to.not.include('\"passwordhash\"');",
          "});",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] non-2xx rows: stack trace / HTML error page presence`, () => {",
          "  if (pm.response.code >= 400) {",
          "    var raw = pm.response.text();",
          "    var looksLikeStackOrHtml = /<html/i.test(raw) || /at\\s+\\S+\\s+\\(.*:\\d+:\\d+\\)/.test(raw);",
          "    if (SQLI_ROWS.indexOf(data.tc_id) !== -1) {",
          "      // SEC-05 backs a hard assertion only here.",
          "      pm.expect(looksLikeStackOrHtml).to.be.false;",
          "    } else {",
          "      pm.environment.set(`observed_stack_or_html_${data.tc_id}`, looksLikeStackOrHtml);",
          "    }",
          "  }",
          "});",
          "",
          "if (CHARACTERIZATION_ROWS.indexOf(data.tc_id) !== -1) {",
          "  pm.test(`[${data.tc_id}][${data.trace}] characterization: Content-Type and JSON parseability recorded, not asserted`, () => {",
          "    pm.environment.set(`observed_content_type_${data.tc_id}`, pm.response.headers.get('Content-Type') || '');",
          "    pm.environment.set(`observed_body_parses_as_json_${data.tc_id}`, safeJson(pm.response) !== null);",
          "  });",
          "}",
          "",
          "pm.test(`[${data.tc_id}][${data.trace}] 2xx responses record observed Content-Type (not asserted)`, () => {",
          "  if (pm.response.code >= 200 && pm.response.code < 300) {",
          "    pm.environment.set(`observed_content_type_${data.tc_id}`, pm.response.headers.get('Content-Type') || '');",
          "  }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Login / Data-Driven Request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function send(config) {",
              "  return new Promise(function (resolve, reject) {",
              "    pm.sendRequest(config, function (error, response) {",
              "      if (error) { reject(error); return; }",
              "      resolve(response);",
              "    });",
              "  });",
              "}",
              "",
              "function sleep(ms) {",
              "  return new Promise(function (resolve) { setTimeout(resolve, ms); });",
              "}",
              "",
              "function waitOutTestLock() {",
              "  return new Promise(function (resolve) {",
              "    var until = Number(pm.environment.get('lockUntil_test'));",
              "    var wait = until ? until - Date.now() : 0;",
              "    if (wait > 0) {",
              "      setTimeout(resolve, wait + 500);",
              "    } else {",
              "      resolve();",
              "    }",
              "  });",
              "}",
              "",
              "function loginConfig(email, password) {",
              "  return {",
              "    url: pm.environment.get('baseUrl') + '/api/login',",
              "    method: 'POST',",
              "    header: {",
              "      'Content-Type': 'application/json',",
              "      'X-Student-Id': pm.environment.get('studentId'),",
              "    },",
              "    body: { mode: 'raw', raw: JSON.stringify({ email: email, password: password }) },",
              "  };",
              "}",
              "",
              "function buildLoginBody() {",
              "  var obj = {};",
              "  if (data.email_raw_json === 'OMIT_KEY') {",
              "    // key intentionally omitted (TC-06)",
              "  } else if (data.email_raw_json === 'RAW_TYPE_NULL') {",
              "    obj.email = null;",
              "  } else if (data.email_raw_json === 'RAW_TYPE_NUMBER') {",
              "    obj.email = Number(data.email);",
              "  } else {",
              "    obj.email = data.email;",
              "  }",
              "  if (data.password_raw_json === 'OMIT_KEY') {",
              "    // key intentionally omitted (TC-10)",
              "  } else if (data.password_raw_json === 'RAW_TYPE_ARRAY') {",
              "    obj.password = JSON.parse(data.password);",
              "  } else {",
              "    obj.password = data.password;",
              "  }",
              "  return obj;",
              "}",
              "",
              "function applyDefaultRequest() {",
              "  pm.request.method = data.method;",
              "  pm.request.url = pm.environment.get('baseUrl') + data.endpoint;",
              "  if (data.body_raw_override) {",
              "    pm.request.body = { mode: 'raw', raw: data.body_raw_override };",
              "  } else {",
              "    pm.request.body = { mode: 'raw', raw: JSON.stringify(buildLoginBody()) };",
              "  }",
              "  if (data.content_type === 'OMIT_HEADER') {",
              "    pm.request.headers.remove('Content-Type');",
              "  } else if (data.content_type) {",
              "    pm.request.headers.upsert({ key: 'Content-Type', value: data.content_type });",
              "  }",
              "}",
              "",
              "var data = pm.iterationData.toObject();",
              "",
              "// Rows whose audited v2 precondition requires test@eshop.com unlocked / counter=0",
              "// (\"reset before running this row\"). The package can only wait out a lock armed",
              "// earlier in this same run; a true counter=0 reset needs DB-level setup (see RUN.md).",
              "var RESET_TEST_ACCOUNT_ROWS = [",
              "  'TC-01', 'TC-02', 'TC-07', 'TC-11', 'TC-21', 'TC-23', 'TC-26', 'TC-38a',",
              "];",
              "",
              "(async () => {",
              "  if (!data.method && !data.endpoint) {",
              "    // Shape 4 (TC-28..TC-31, TC-42): cross-response analysis, no new request under",
              "    // test. Harmless placeholder so the Test phase still records assertions (sandbox",
              "    // constraint 5) -- GET on this FR's POST-only route, no SUT state mutation.",
              "    pm.request.method = 'GET';",
              "    pm.request.url = pm.environment.get('baseUrl') + '/api/login';",
              "    pm.request.body.mode = 'raw';",
              "    pm.request.body.raw = '';",
              "    pm.request.headers.remove('Content-Type');",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-13' || data.tc_id === 'TC-14' || data.tc_id === 'TC-15') {",
              "    // Fresh 3-failure sequence arms a new lock, then wait to this row's own",
              "    // boundary offset before firing the real (visible) timed request.",
              "    var targetMs = data.tc_id === 'TC-13' ? 29000 : (data.tc_id === 'TC-14' ? 30000 : 31000);",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    var t0 = Date.now();",
              "    pm.environment.set('lockUntil_test', t0 + 30000);",
              "    var wait = targetMs - (Date.now() - t0);",
              "    if (wait > 0) await sleep(wait);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (RESET_TEST_ACCOUNT_ROWS.indexOf(data.tc_id) !== -1) {",
              "    await waitOutTestLock();",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-16') {",
              "    // The row itself is the 3-consecutive-attempt sequence; no single visible",
              "    // request represents it, so all traffic goes through send() and the",
              "    // per-attempt assertions live here (sandbox constraint 5: real traffic",
              "    // already fired before skipRequest()).",
              "    var r1 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] attempt 1 rejected (same error class as EC-09)`, () => {",
              "      pm.expect(r1.code).to.not.eql(200);",
              "    });",
              "    var r2 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] attempt 2 rejected (same error class as EC-09)`, () => {",
              "      pm.expect(r2.code).to.not.eql(200);",
              "    });",
              "    var r3 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] attempt 3 triggers lock (counter reaches 3)`, () => {",
              "      pm.expect(r3.code).to.not.eql(200);",
              "    });",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-19') {",
              "    // Precondition needs a fresh (unlocked) account before the 1-failure setup.",
              "    await waitOutTestLock();",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    var step1 = await send(loginConfig(data.email, data.password));",
              "    pm.test(`[${data.tc_id}][${data.trace}] step1 success login returns 200+token`, () => {",
              "      pm.expect(step1.code).to.eql(200);",
              "      pm.expect(step1.json()).to.have.property('token');",
              "    });",
              "    var step2 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-19-step2', step2.code);",
              "    pm.test(`[${data.tc_id}][${data.trace}] step2 follow-up failure recorded (reset-vs-cumulative is UNSPECIFIED)`, () => {",
              "      pm.expect(step2.code).to.not.eql(200);",
              "    });",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-20') {",
              "    // Wait out TC-16's 30s lock window (plus margin), then fire 3 more",
              "    // consecutive failures and record which attempt re-triggers the lock --",
              "    // the post-unlock counter value is UNSPECIFIED, so no attempt number is",
              "    // asserted as *the* one that re-locks.",
              "    await waitOutTestLock();",
              "    var attempts = [];",
              "    for (var i = 0; i < 3; i++) {",
              "      var res = await send(loginConfig(data.email, data.password));",
              "      attempts.push(res.code);",
              "      pm.environment.set(`observed_status_TC-20-attempt${i + 1}`, res.code);",
              "      pm.test(`[${data.tc_id}][${data.trace}] attempt ${i + 1} rejected`, () => {",
              "        pm.expect(res.code).to.not.eql(200);",
              "      });",
              "    }",
              "    // The post-unlock counter (and thus which attempt re-arms the lock) is",
              "    // UNSPECIFIED; conservatively assume this 2nd cycle re-locked the account",
              "    // so downstream rows requiring \"unlocked\" wait it out correctly.",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-36') {",
              "    // Setup needs a fresh (unlocked) account, then two prior wrong-password",
              "    // attempts bring counter to 2, then this row's own correct-credential",
              "    // request fires as the real visible request.",
              "    await waitOutTestLock();",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-38b') {",
              "    // auth_bearer_from: reuse the token captured from TC-38a's own response",
              "    // (the collection-level capture already stored it) instead of a fresh fetch.",
              "    var capturedRaw = pm.environment.get(`captured_${data.auth_bearer_from}`);",
              "    var capturedParsed = capturedRaw ? JSON.parse(capturedRaw) : null;",
              "    var token = '';",
              "    if (capturedParsed && capturedParsed.body) {",
              "      try { token = JSON.parse(capturedParsed.body).token || ''; } catch (e) { token = ''; }",
              "    }",
              "    pm.request.method = data.method;",
              "    pm.request.url = pm.environment.get('baseUrl') + data.endpoint;",
              "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
              "    pm.request.headers.remove('Content-Type');",
              "    pm.request.body = { mode: 'raw', raw: '' };",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-39') {",
              "    // Cross-actor: lock actor A (test@eshop.com) first, then this row's own",
              "    // request logs in as actor B (admin@eshop.com). Audited v2 oracle is",
              "    // UNSPECIFIED (counter/lock scope undocumented) -- outcome is recorded by",
              "    // the collection-level generic tests, not asserted here.",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-40') {",
              "    // Concurrency: precondition requires a reset/unlocked account, then 3",
              "    // wrong-password attempts fired without waiting for each other, then a",
              "    // correct-credential verification call.",
              "    await waitOutTestLock();",
              "    var fire = function () { return send(loginConfig(data.email, data.password)); };",
              "    var results = await Promise.all([fire(), fire(), fire()]);",
              "    results.forEach(function (res, i) {",
              "      pm.environment.set(`observed_status_TC-40-attempt${i + 1}`, res.code);",
              "      pm.test(`[${data.tc_id}][${data.trace}] concurrent attempt ${i + 1} recorded`, () => {",
              "        pm.expect(res.code).to.not.eql(200);",
              "      });",
              "    });",
              "    var verify = await send(loginConfig(data.email, 'Test1234!'));",
              "    pm.test(`[${data.tc_id}][${data.trace}] final state is LOCKED (no lost-update: correct creds still rejected)`, () => {",
              "      pm.expect(verify.code).to.not.eql(200);",
              "    });",
              "    // The verification attempt above confirms the account ends LOCKED; arm the",
              "    // guard so downstream reset-precondition rows (TC-43a) wait it out.",
              "    pm.environment.set('lockUntil_test', Date.now() + 30000);",
              "    pm.execution.skipRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-43a') {",
              "    // First step of the TC-43a..TC-43g interleave. Its precondition requires both",
              "    // accounts fresh/reset; the only reset this package can perform is waiting out",
              "    // a lock armed earlier in this run. TC-43b..TC-43g deliberately do NOT wait --",
              "    // the unbroken interleave order is the property under test.",
              "    await waitOutTestLock();",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-44') {",
              "    // Trigger guard (srs.md line 42 \"lien tiep\"): fail, fail, success, fail, fail,",
              "    // then this row's own 6th attempt with correct credentials. Attempts 1-5 are",
              "    // setup: their outcomes are recorded, not asserted (audited oracle).",
              "    await waitOutTestLock();",
              "    var s1 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-44-step1-fail', s1.code);",
              "    var s2 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-44-step2-fail', s2.code);",
              "    var s3 = await send(loginConfig(data.email, data.password));",
              "    pm.environment.set('observed_status_TC-44-step3-success', s3.code);",
              "    var s4 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-44-step4-fail', s4.code);",
              "    var s5 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-44-step5-fail', s5.code);",
              "    // No run of 3 consecutive failures occurred, so the account must not be",
              "    // locked; the 6th attempt fires as this row's visible request and its",
              "    // documented 200 is asserted by the collection-level generic test.",
              "    pm.environment.set('lockUntil_test', 0);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-45') {",
              "    // TTL renewal boundary: lock at T=0, one wrong-password attempt at T=10s and",
              "    // T=15s (inside the window, expected rejected, not asserted by this row),",
              "    // then this row's own correct-credential request at T=31s.",
              "    await waitOutTestLock();",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    await send(loginConfig(data.email, 'WrongPass1!'));",
              "    var lockT0 = Date.now();",
              "    pm.environment.set('lockUntil_test', lockT0 + 30000);",
              "    var w10 = 10000 - (Date.now() - lockT0);",
              "    if (w10 > 0) await sleep(w10);",
              "    var in10 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-45-T10s', in10.code);",
              "    var w15 = 15000 - (Date.now() - lockT0);",
              "    if (w15 > 0) await sleep(w15);",
              "    var in15 = await send(loginConfig(data.email, 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-45-T15s', in15.code);",
              "    var w31 = 31000 - (Date.now() - lockT0);",
              "    if (w31 > 0) await sleep(w31);",
              "    // T=31s is past the 30s window; if the TTL was not renewed the account is",
              "    // unlocked and this row's documented 200 holds.",
              "    pm.environment.set('lockUntil_test', 0);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  if (data.tc_id === 'TC-46') {",
              "    // EP x State intersection: 3 consecutive failures across email case variants,",
              "    // then an exact-case correct-credential probe. Whether the variants share one",
              "    // counter depends on TC-02's recorded case-sensitivity result, so the setup",
              "    // outcomes are recorded and this row's own result is UNSPECIFIED.",
              "    await waitOutTestLock();",
              "    var v1 = await send(loginConfig('test@eshop.com', 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-46-variant-lower', v1.code);",
              "    var v2 = await send(loginConfig('TEST@ESHOP.COM', 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-46-variant-upper', v2.code);",
              "    var v3 = await send(loginConfig('Test@Eshop.com', 'WrongPass1!'));",
              "    pm.environment.set('observed_status_TC-46-variant-mixed', v3.code);",
              "    applyDefaultRequest();",
              "    return;",
              "  }",
              "",
              "  applyDefaultRequest();",
              "})();"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function captured(tcId) {",
              "  var raw = pm.environment.get(`captured_${tcId}`);",
              "  return raw ? JSON.parse(raw) : null;",
              "}",
              "",
              "var data = pm.iterationData.toObject();",
              "",
              "if (data.tc_id === 'TC-28') {",
              "  // Audited v2 oracle: RECORD (do not assert) whether the five error bodies share a",
              "  // top-level key set. The credential-rejection subset is governed by TC-29/TC-42;",
              "  // the required-field subset has no defined envelope, so a difference there is an",
              "  // observation, not a defect.",
              "  var refs28 = (data.precondition_note.match(/TC-\\d+[a-z]?/g) || []);",
              "  var rows28 = refs28.map((id) => captured(id));",
              "  pm.test(`[${data.tc_id}][${data.trace}] characterization: top-level key set of the five error bodies recorded, not asserted`, () => {",
              "    rows28.forEach((c, i) => pm.expect(c, `missing captured response for ${refs28[i]}`).to.not.eql(null));",
              "    var keySets = rows28.map((c) => Object.keys(JSON.parse(c.body || '{}')).sort().join(','));",
              "    refs28.forEach((id, i) => pm.environment.set(`observed_key_set_${id}`, keySets[i]));",
              "    pm.environment.set('observed_key_sets_identical_TC-28', new Set(keySets).size === 1);",
              "  });",
              "}",
              "",
              "if (data.tc_id === 'TC-29') {",
              "  var refs29 = (data.precondition_note.match(/TC-\\d+[a-z]?/g) || []);",
              "  var rows29 = refs29.map((id) => captured(id));",
